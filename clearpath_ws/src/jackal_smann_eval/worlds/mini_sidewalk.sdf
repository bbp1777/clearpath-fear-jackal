<?xml version="1.0"?>
<sdf version="1.10">
  <world name="mini_sidewalk">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.70 0.70 0.70 1</ambient>
      <background>0.82 0.90 0.98 1</background>
      <shadows>true</shadows>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 0.15 -0.92</direction>
    </light>

    <!-- Large flat base so the sidewalk, grass, and obstacles all sit flush. -->
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>40 16 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>40 16 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.36 0.38 0.38 1</ambient>
            <diffuse>0.36 0.38 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The training corridor: goal coverage is measured by how much of the green block fills the RGB view. -->
    <model name="sidewalk">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 2.6 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 2.6 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.84 0.82 0.78 1</ambient>
            <diffuse>0.84 0.82 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Flush terminal regions on both sides so leaving the sidewalk is unambiguous. -->
    <model name="grass_left">
      <static>true</static>
      <pose>0 -4.0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>40 5.4 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>40 5.4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.42 0.18 1</ambient>
            <diffuse>0.18 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="grass_right">
      <static>true</static>
      <pose>0 4.0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>40 5.4 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>40 5.4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.42 0.18 1</ambient>
            <diffuse>0.18 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple visual goal block, kept obstacle-free so progress is dominated by RGB goal coverage. -->
    <model name="goal_block">
      <static>true</static>
      <pose>12.5 0 0.45 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 2.0 0.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.80 0.10 1</ambient>
            <diffuse>0.10 0.80 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Brown collision boxes are the only discrete obstacles in the simplified task. -->
    <model name="box_01">
      <static>true</static>
      <pose>-8.0 0.55 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_02">
      <static>true</static>
      <pose>-2.5 -0.45 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_03">
      <static>true</static>
      <pose>3.5 0.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_04">
      <static>true</static>
      <pose>8.5 -0.55 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

