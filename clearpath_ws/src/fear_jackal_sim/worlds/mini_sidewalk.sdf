<?xml version="1.0"?>
<sdf version="1.10">
  <world name="mini_sidewalk">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.70 0.70 0.70 1</ambient>
      <background>0.82 0.90 0.98 1</background>
      <shadows>true</shadows>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 0.15 -0.92</direction>
    </light>

    <!-- Large flat base so the sidewalk, grass, and obstacles all sit flush. -->
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>40 16 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>40 16 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.36 0.38 0.38 1</ambient>
            <diffuse>0.36 0.38 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The training corridor: goal coverage is measured by how much of the bright green block fills the RGB view. -->
    <model name="sidewalk">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 2.6 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 2.6 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.84 0.82 0.78 1</ambient>
            <diffuse>0.84 0.82 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Flush terminal regions on both sides so leaving the sidewalk is unambiguous. -->
    <model name="grass_left">
      <static>true</static>
      <pose>0 -4.0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>40 5.4 0.02</size>
            </box>
          </geometry>
        </collision>
        <sensor name="terminal_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/jackal_sidewalk/sim/contacts/grass_left</topic>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
        <visual name="visual">
          <geometry>
            <box>
              <size>40 5.4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.42 0.18 1</ambient>
            <diffuse>0.18 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-touchplugin-system" name="gz::sim::systems::TouchPlugin">
        <target>jackal_sidewalk/robot</target>
        <namespace>jackal_sidewalk/sim/touched/grass_left</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
    </model>

    <model name="grass_right">
      <static>true</static>
      <pose>0 4.0 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>40 5.4 0.02</size>
            </box>
          </geometry>
        </collision>
        <sensor name="terminal_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/jackal_sidewalk/sim/contacts/grass_right</topic>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
        <visual name="visual">
          <geometry>
            <box>
              <size>40 5.4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.42 0.18 1</ambient>
            <diffuse>0.18 0.42 0.18 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-touchplugin-system" name="gz::sim::systems::TouchPlugin">
        <target>jackal_sidewalk/robot</target>
        <namespace>jackal_sidewalk/sim/touched/grass_right</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
    </model>

    <!-- Simple visual goal block; success is determined only by RGB coverage of this marker. -->
    <model name="goal_block">
      <static>true</static>
      <pose>12.5 0 0.45 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>1.2 2.0 0.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.00 1.00 0.00 1</ambient>
            <diffuse>0.00 1.00 0.00 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Brown collision boxes are the only discrete obstacles in the simplified task. -->
    <model name="box_01">
      <static>true</static>
      <pose>-8.0 0.55 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <sensor name="terminal_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/jackal_sidewalk/sim/contacts/box_01</topic>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-touchplugin-system" name="gz::sim::systems::TouchPlugin">
        <target>jackal_sidewalk/robot</target>
        <namespace>jackal_sidewalk/sim/touched/box_01</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
    </model>

    <model name="box_02">
      <static>true</static>
      <pose>-2.5 -0.45 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 0.7</size>
            </box>
          </geometry>
        </collision>
        <sensor name="terminal_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/jackal_sidewalk/sim/contacts/box_02</topic>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-touchplugin-system" name="gz::sim::systems::TouchPlugin">
        <target>jackal_sidewalk/robot</target>
        <namespace>jackal_sidewalk/sim/touched/box_02</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
    </model>

    <model name="box_03">
      <static>true</static>
      <pose>3.5 0.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <sensor name="terminal_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/jackal_sidewalk/sim/contacts/box_03</topic>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-touchplugin-system" name="gz::sim::systems::TouchPlugin">
        <target>jackal_sidewalk/robot</target>
        <namespace>jackal_sidewalk/sim/touched/box_03</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
    </model>

    <model name="box_04">
      <static>true</static>
      <pose>8.5 -0.55 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
        </collision>
        <sensor name="terminal_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/jackal_sidewalk/sim/contacts/box_04</topic>
          <contact>
            <collision>collision</collision>
          </contact>
        </sensor>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.7 0.7 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.25 0.12 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-touchplugin-system" name="gz::sim::systems::TouchPlugin">
        <target>jackal_sidewalk/robot</target>
        <namespace>jackal_sidewalk/sim/touched/box_04</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
    </model>
  </world>
</sdf>

